# Copy to .env (never commit the real .env).

# Where the Vite dev/preview proxy forwards /api/* (the main HeatShield backend).
VITE_RISK_API_TARGET=http://127.0.0.1:8000

# Optional. Leave EMPTY in development (the proxy handles /api).
# Set only when the built frontend is served separately from the API, e.g.
# VITE_API_BASE_URL=https://risk.example.com
VITE_API_BASE_URL=
