# ─────────────────────────────────────────────────────────────────────────────
# HeatShield Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in any values you want to override.
# The defaults below work out-of-the-box — no API key is required for
# Open-Meteo.
#
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Open-Meteo API endpoints (no API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search

# HTTP request timeout in seconds
REQUEST_TIMEOUT_SECONDS=10

# In-memory cache TTL in seconds (default: 5 minutes)
CACHE_TTL_SECONDS=300

# CORS origins (comma-separated) — add your frontend URL here
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ─────────────────────────────────────────────────────────────────────────────
# If you switch to a provider that requires an API key, add it here:
# (do NOT hard-code keys in source files)
# WEATHER_API_KEY=your_secret_key_here
# ─────────────────────────────────────────────────────────────────────────────
