# ---- Backend (backend/.env — copy from backend/.env.example) ------------
# No API key is needed: weather comes from Open-Meteo.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# REQUEST_TIMEOUT_SECONDS=10
# CACHE_TTL_SECONDS=300
# RISK_ENGINE_DIR=          # optional override of <repo>/risk_engine

# ---- Frontend (frontend/.env — copy from frontend/.env.example) ---------
# VITE_RISK_API_TARGET=http://127.0.0.1:8000   # Vite proxy target
# VITE_API_BASE_URL=                           # leave empty in development
